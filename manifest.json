{
  "manifest_version": 3,
  "name": "TabShare",
  "version": "1.3.0",
  "description": "Share tab groups as a link",
  "homepage_url": "https://github.com/SidhuAchary02/tabshare-extension",
  "permissions": ["tabs", "tabGroups", "clipboardWrite", "storage"],
  "icons": {
    "16": "icons/tabshare16.png",
    "48": "icons/tabshare48.png",
    "128": "icons/tabshare128.png"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
