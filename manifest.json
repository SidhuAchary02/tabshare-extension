{
  "manifest_version": 3,
  "name": "TabShare - Share tab groups as link",
  "version": "1.3.2",
  "description": "TabShare is a lightweight extension that lets you share a browser tab group as a link and restore it later.",
  "homepage_url": "https://tabshare-six.vercel.app/",
  "permissions": ["tabs", "tabGroups", "clipboardWrite", "storage"],
  "host_permissions": [
    "https://tabshare-six.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://tabshare-six.vercel.app/*"],
      "js": ["content-script.js"]
    }
  ],
  "icons": {
    "16": "icons/tabshare16.png",
    "48": "icons/tabshare48.png",
    "128": "icons/tabshare128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
